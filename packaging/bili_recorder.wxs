<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     WiX Toolset v3 脚本 —— 生成 MSI 安装包
     依赖: 先运行 packaging\build.ps1 生成 dist\BiliStreamRecorder.exe
     用法:
       candle.exe packaging\bili_recorder.wxs -o dist\obj\
       light.exe dist\obj\bili_recorder.wixobj -o dist\BiliStreamRecorder-Setup-1.0.0.msi
     ============================================================ -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="B站直播录播+自动投稿"
           Language="2052"
           Version="1.0.0"
           Manufacturer="BiliStreamRecorder"
           UpgradeCode="8A5F2B1C-3D4E-4F6A-8B2C-1D3E5F7A9B0C">
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="B站直播录播 + 自动投稿工具"
             Manufacturer="BiliStreamRecorder" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本。" Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="BiliStreamRecorder" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Icon Id="AppIcon" SourceFile="..\assets\icon.ico" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="BiliStreamRecorder" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="B站直播录播+自动投稿" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExeComponent" Guid="*">
        <File Id="MainExeFile"
              Name="BiliStreamRecorder.exe"
              Source="..\dist\BiliStreamRecorder.exe"
              KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="B站直播录播+自动投稿"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="yes" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="B站直播录播+自动投稿"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="yes" />
        <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
